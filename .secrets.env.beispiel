# Diese drei Werte unterschreiben die Anmeldung an der Oberflaeche.
# start.sh erzeugt sie EINMAL als .secrets.env. Gehen sie verloren, ist jeder
# Benutzer ausgesperrt - also mitsichern, wenn der Rechner gesichert wird.
# Von Hand erzeugen:  openssl rand -hex 32
JWT_SECRET=
SIG_KEY=
SIG_SALT=

# API-Schluessel von AnythingLLM (Oberflaeche -> Einstellungen -> Werkzeuge ->
# API-Schluessel). Wird fuer die Dokument-Aufnahme UND fuer die Selbstheilung
# neuer Arbeitsbereiche gebraucht. Nach dem ersten Start hier eintragen
# (siehe README, Schritt 3.3). start.sh legt die Zeile leer schon an.
KI4KI_API_KEY=
