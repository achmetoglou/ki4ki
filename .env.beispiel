# ============================================================================
#  KI4KI - Einstellungen (.env)
#
#  Diese Datei ist eine VORLAGE. Die echte Datei heisst ".env" und liegt im
#  selben Ordner; start.sh legt sie an. Sie enthaelt nur, was vom Standard
#  abweicht - alles andere laeuft mit den Werten, die hier hinter "=" stehen.
#
#  Etwas aendern: Zeile in die .env kopieren, das "#" am Anfang entfernen,
#  Wert anpassen, dann im Projektordner:  docker compose up -d
#  Ein Update der Anlage (aktualisiere.sh) fasst die .env nie an.
#
#  Geheimnisse (Anmelde-Schluessel, API-Schluessel) stehen NICHT hier,
#  sondern in .secrets.env - die bleibt unangetastet.
# ============================================================================

# --- Wird von start.sh gesetzt - nicht von Hand aendern ---------------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml   # Grund-Datei plus GPU-Ergaenzung (ohne Karte: nur die Grund-Datei)
# KI4KI_UID=1000        # wird von start.sh geschrieben, derzeit ohne Wirkung (Eigentuemer ist immer 1000)
# KI4KI_GID=1000        # Gruppe, der dokumente/ gehoert - darueber bekommt das SFTP-Konto Schreibrecht

# --- Wer darf was sehen -----------------------------------------------------
# KI4KI_PROTOKOLL_EINSICHT=admin   # Konten (Komma-getrennt), die /kpi, /rueckmeldungen, /protokoll, /selbstcheck sehen - auch ohne Admin-Rolle
# KI4KI_EINSICHT_ADMINS=1          # 1 = jeder AnythingLLM-Administrator sieht diese Seiten automatisch; 0 = nur die Liste oben
# KI4KI_PROTOKOLL_TAGE=90          # Aufbewahrung des Pruefprotokolls in Tagen
# KI4KI_KONTAKT=                   # Name/Mail des Ansprechpartners, den die Anlage bei Stoerfaellen ohne Beleg nennt

# --- Platzverbrauch der Ablaufsteuerung -------------------------------------
# n8n hebt zu jedem Durchgang die Daten auf - samt der gelesenen Dateien, die mit
# N8N_DEFAULT_BINARY_DATA_MODE=filesystem unter /home/node/.n8n/storage/workflows/ liegen.
# ⛔ AB WERK raeumt n8n erst bei 10.000 Ausfuehrungen oder 336 Stunden auf. Bei einem
#   Durchgang je Minute ist die Platte lange vorher voll: gemessen am 06.10. lagen
#   116,8 GB in 8.355 Ausfuehrungsordnern, /dev/sda3 stand auf 100 %, und die Aufnahme
#   meldete stundenlang "0 zu verarbeiten", obwohl der Eingang voll war (ENOSPC).
#   Rechnung nach dem Umbau (Zahlen am 06.10. im Container nachgemessen, nicht geschaetzt):
#   25 Dateien je Durchgang zu im Mittel 4,22 MB = rund 106 MB. Bestand: 6.798 Dateien,
#   28,67 GB; 69 davon ueber 50 MB, 27 ueber 150 MB, groesste 539 MB.
#   200 aufbewahrte Durchgaenge x 106 MB = rund 21 GB - von 117 GB freiem Platz.
# ⛔ MAX_COUNT ist KEIN Byte-Deckel: er zaehlt Durchgaenge. Die 25 schwersten Dateien
#   des Bestands sind zusammen 7,71 GB - so viel kann EIN Durchgang wiegen. Was die
#   Bytes wirklich deckelt, ist MAX_AGE: in 48 Stunden passen bei 34-49 Dokumenten je
#   Stunde hoechstens 2.352 Dokumente, und die 2.352 schwersten wiegen 27,3 GB.
#   Waechst der Bestand oder der Durchsatz, MAX_AGE senken (24 statt 48), nicht MAX_COUNT.
# EXECUTIONS_DATA_PRUNE=true                    # Aufraeumen ueberhaupt
# EXECUTIONS_DATA_MAX_AGE=48                    # Hoechstalter in STUNDEN (Werk 336)
# EXECUTIONS_DATA_PRUNE_MAX_COUNT=200           # Hoechstzahl aufbewahrter Durchgaenge (Werk 10000)
# EXECUTIONS_DATA_PRUNE_SOFT_DELETE_INTERVAL=15 # Takt in Minuten: vormerken (Werk 60)
# EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL=5  # Takt in Minuten: wirklich loeschen (Werk 15)
#                                  # ⚠ Erst das HARTE Loeschen gibt Platz frei; bis dahin liegen die
#                                  #   Dateien weiter da. Zusaetzlich gilt eine Schonfrist von einer
#                                  #   Stunde (EXECUTIONS_DATA_HARD_DELETE_BUFFER), damit man einen
#                                  #   frischen Fehler noch ansehen kann.

# --- Aufnahme von Dokumenten ------------------------------------------------
# KI4KI_MASSENLAUF_AB=6            # ab so vielen Dateien im Eingang: schneller Massenlauf ohne Bildbeschreibung
# KI4KI_MENGE_JE_LAUF=25           # Dateien je Durchgang
# KI4KI_CLAIM_MINUTEN=180          # nach so vielen Minuten gilt eine Datei in input/ als liegengeblieben und wandert nach aussortiert/
#                                  # ⛔ VOR EINEM MASSENLAUF HOCHSETZEN: 25 Dateien/Durchgang bei 1 Durchgang/Minute und gemessenen
#                                  #   34-49 Dokumenten/h heissen fuer ein paar tausend Dateien TAGE. Nach 180 Minuten wandern sonst
#                                  #   alle noch nicht verarbeiteten Dateien auf einen Schlag nach aussortiert/ (gleicher ctime).
#                                  #   Richtwert: geplante Laufzeit in Minuten mal zwei. Danach wieder auf 180 zuruecksetzen.
#                                  # ⛔ HOECHSTENS SIEBEN STELLEN. Gueltig ist eine ganze Zahl von 1 bis 9999999 (= 19 Jahre).
#                                  #   Ein Wert mit ACHT oder mehr Stellen gilt als ungueltig und faellt auf 180 zurueck - ebenso
#                                  #   leer, 0, negativ oder Buchstaben. Wer die Garantie "abschalten" will und 10000000 eintraegt,
#                                  #   bekommt also 180 Minuten, das Gegenteil. Dann 9999999 nehmen. Die Warnung dazu steht nur in
#                                  #   der n8n-Ausfuehrung (Port 5678), nicht in einer Mail.
# KI4KI_BILDBESCHREIBUNG=aus       # an = Abbildungen bei der Aufnahme beschreiben lassen (~6 s je Bild)
# KI4KI_FORMELN=aus                # an = Formeln als LaTeX erkennen (~6 min je Dissertation)
# KI4KI_DOCLING_THREADS=12         # Prozessorkerne fuer Docling
# KI4KI_LOESCHEN=1                 # 1 = Dateien in dokumente/<bereich>/loeschen/ werden vollstaendig entfernt

# --- Gespraech und Modell ---------------------------------------------------
# KI4KI_GESPRAECH=1                # 1 = das Modell fuehrt das Gespraech mit den Werkzeugen des Proxys; 0 = alter Regel-Router
# KI4KI_GESPRAECH_MODELL=gemma4:12b
# KI4KI_GESPRAECH_TIMEOUT=240      # Sekunden je Modellaufruf
# KI4KI_GESPRAECH_RUNDEN=5         # Werkzeug-Runden je Frage
# KI4KI_GESPRAECH_BUDGET=300       # Gesamtbudget je Frage in Sekunden - danach ehrlicher Abbruch statt endlosem 'Denke nach'
# KI4KI_ABSICHT_MODELL=1           # 1 = das Modell erkennt die Absicht einer Frage (Stufe 1)
# KI4KI_ABSICHT_MODELL_NAME=gemma4:12b
# KI4KI_AUFFANGNETZ=1              # 1 = kleines Modell ordnet Fragen ein, die keine Regel erkennt
# KI4KI_E2B_ANTWORT=1              # 1 = kleines Modell beantwortet schlichte Definitionsfragen
# KI4KI_MODELL_ANZEIGE=1           # 1 = unter jeder Antwort steht, welches Modell geantwortet hat
# KI4KI_NENNUNG_TILGEN=1           # 1 = Modellnamen aus dem Antworttext entfernen
# KI4KI_ROLLE_GLAETTEN=1           # 1 = das Modell formuliert den Rollen-Absatz aus den drei Feldern; 0 = Vorlage woertlich
# KI4KI_BEREICH_HEILEN=1           # 1 = neue Bereiche bekommen automatisch die geprueften Einstellungen
# KI4KI_MODELLE_ERLAUBT=           # zusaetzlich erlaubte Modelle je Bereich (Komma); installierte Ollama-Modelle sind immer erlaubt

# --- Grenzen und Zeiten -----------------------------------------------------
# KI4KI_MAX_UPLOAD=209715200       # groesste Datei beim Hochladen in Bytes (200 MB). Steht ein Reverse-Proxy davor, dessen Grenze mitziehen - sonst scheitert der Upload dort
# KI4KI_ZUGANG_DAUER=43200         # wie lange eine Anmeldung gilt, in Sekunden (12 Stunden)
# KI4KI_OFFICE_ZEITLIMIT=900       # Sekunden, die LibreOffice fuer eine Wandlung Word/PowerPoint -> PDF bekommen darf
# KI4KI_ZUSAMMENFASSUNG_STUECK=110000  # Zeichen je Durchgang beim mehrstufigen Zusammenfassen

# --- Feineinstellung der Absicht (Stufe 1) ----------------------------------
# KI4KI_ABSICHT_MINDEST=0.6        # ab welcher Sicherheit die erkannte Absicht gilt; darunter fragt die Anlage zurueck
# KI4KI_ABSICHT_TIMEOUT=25         # Sekunden fuer den Absichts-Aufruf
# KI4KI_NETZ_MODELL=gemma4:e2b     # kleines Modell fuer Auffangnetz und schlichte Fragen
# KI4KI_NETZ_TIMEOUT=8             # Sekunden fuer das kleine Modell

# --- Antwortwege einzeln abschalten -----------------------------------------
# KI4KI_META_ANTWORT=1             # 1 = Fragen an die Anlage selbst ("was kannst du?") beantwortet der Proxy direkt
# KI4KI_ALLROUNDER=1               # 1 = Allgemeinwissen im Chat-Modus zulassen (sichtbar gekennzeichnet)
# KI4KI_BILD_ANTWORT=1             # 1 = Bildfragen ("zeig mir Bild 2.1") gehen den direkten Bild-Weg
# KI4KI_GESPRAECH_DENKEN=0         # 1 = das Modell darf in Stufe 2 laut denken (langsamer, nur zur Fehlersuche)
