# ============================================================================
#  KI4KI - Einstellungen (.env)
#
#  Diese Datei ist eine VORLAGE. Die echte Datei heisst ".env" und liegt im
#  selben Ordner; start.sh legt sie an. Sie enthaelt nur, was vom Standard
#  abweicht - alles andere laeuft mit den Werten, die hier hinter "=" stehen.
#
#  Etwas aendern: Zeile in die .env kopieren, das "#" am Anfang entfernen,
#  Wert anpassen, dann im Projektordner:  docker compose up -d
#  Ein Update der Anlage (aktualisiere.sh) fasst die .env nie an.
#
#  Geheimnisse (Anmelde-Schluessel, API-Schluessel) stehen NICHT hier,
#  sondern in .secrets.env - die bleibt unangetastet.
# ============================================================================

# --- Wird von start.sh gesetzt - nicht von Hand aendern ---------------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml   # Grund-Datei plus GPU-Ergaenzung (ohne Karte: nur die Grund-Datei)
# KI4KI_UID=1000        # Benutzer-Nummer des Server-Kontos, dem dokumente/ gehoert (SFTP)
# KI4KI_GID=1000        # Gruppen-Nummer dazu

# --- Wer darf was sehen -----------------------------------------------------
# KI4KI_PROTOKOLL_EINSICHT=admin   # Konten (Komma-getrennt), die /kpi, /rueckmeldungen, /protokoll, /selbstcheck sehen - auch ohne Admin-Rolle
# KI4KI_EINSICHT_ADMINS=1          # 1 = jeder AnythingLLM-Administrator sieht diese Seiten automatisch; 0 = nur die Liste oben
# KI4KI_PROTOKOLL_TAGE=90          # Aufbewahrung des Pruefprotokolls in Tagen
# KI4KI_KONTAKT=                   # Name/Mail des Ansprechpartners, den die Anlage bei Stoerfaellen ohne Beleg nennt

# --- Aufnahme von Dokumenten ------------------------------------------------
# KI4KI_MASSENLAUF_AB=6            # ab so vielen Dateien im Eingang: schneller Massenlauf ohne Bildbeschreibung
# KI4KI_MENGE_JE_LAUF=25           # Dateien je Durchgang
# KI4KI_BILDBESCHREIBUNG=aus       # an = Abbildungen bei der Aufnahme beschreiben lassen (~6 s je Bild)
# KI4KI_FORMELN=aus                # an = Formeln als LaTeX erkennen (~6 min je Dissertation)
# KI4KI_DOCLING_THREADS=12         # Prozessorkerne fuer Docling
# KI4KI_LOESCHEN=1                 # 1 = Dateien in dokumente/<bereich>/loeschen/ werden vollstaendig entfernt

# --- Gespraech und Modell ---------------------------------------------------
# KI4KI_GESPRAECH=1                # 1 = das Modell fuehrt das Gespraech mit den Werkzeugen des Proxys; 0 = alter Regel-Router
# KI4KI_GESPRAECH_MODELL=gemma4:12b
# KI4KI_ABSICHT_MODELL=1           # 1 = das Modell erkennt die Absicht einer Frage (Stufe 1)
# KI4KI_ABSICHT_MODELL_NAME=gemma4:12b
# KI4KI_AUFFANGNETZ=1              # 1 = kleines Modell ordnet Fragen ein, die keine Regel erkennt
# KI4KI_E2B_ANTWORT=1              # 1 = kleines Modell beantwortet schlichte Definitionsfragen
# KI4KI_MODELL_ANZEIGE=1           # 1 = unter jeder Antwort steht, welches Modell geantwortet hat
# KI4KI_NENNUNG_TILGEN=1           # 1 = Modellnamen aus dem Antworttext entfernen
# KI4KI_ROLLE_GLAETTEN=1           # 1 = das Modell formuliert den Rollen-Absatz aus den drei Feldern; 0 = Vorlage woertlich
# KI4KI_BEREICH_HEILEN=1           # 1 = neue Bereiche bekommen automatisch die geprueften Einstellungen
