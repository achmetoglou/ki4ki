    {
      "parameters": {
        "jsCode": "// Docling liefert JSON; der restliche Workflow erwartet den Text in $json.data.\n//\n// ⚠ STATUS PRUEFEN (gemessen 25.08., DS-25-001): Docling meldete\n//   status \"failure\" (\"pipeline terminated early\", S. 33 und 96 - kaputte\n//   Zeichenkodierung in der PDF) und lieferte LEEREN Text. Der Workflow\n//   lief mit leerem Text weiter, bis ganz hinten \"im Arbeitsbereich nicht\n//   wiedergefunden\" im Protokoll stand - der wahre Grund war unsichtbar.\n//   Deshalb hier: Fehler benennen und (bei leerem Text) den Zweitversuch\n//   mit anderem PDF-Backend anstossen.\nreturn $input.all().map(item => {\n  const j = item.json || {};\n  const doc = j.document || {};\n  const md = doc.md_content || doc.text_content || '';\n  const kaputt = (j.status && j.status !== 'success') || !md.trim();\n  const gruende = (j.errors || []).slice(0, 3).map(e =>\n    (e.error_message || JSON.stringify(e)) + (e.page_no ? ' (S. ' + e.page_no + ')' : '')\n  ).join('; ');\n  const fehler = kaputt\n    ? ('Docling ' + (j.status || 'ohne Status') + ': ' + (gruende || 'kein Text geliefert'))\n    : '';\n  return { json: { data: md.trim() ? md : '', docling_filename: doc.filename || null,\n                   seiten: (md.match(/\\[\\[SEITE\\]\\]/g) || []).length + 1,\n                   fehler: fehler, versuch: 1,\n                   // Ohne Bildbeschreibung aufgenommen? Dann auf die Vormerkliste\n                   // (Massenlauf ODER Schalter KI4KI_BILDBESCHREIBUNG=aus, der Standard).\n                   ohne_bilder: (() => { try {\n                     const ml = $('Start').first().json.massenlauf;\n                     if (ml === true || ml === 'true') return true;\n                     return String(($env && $env.KI4KI_BILDBESCHREIBUNG) || 'aus') === 'aus';\n                   } catch (e) { return true; } })() },\n           binary: item.binary };\n});\n"
      },
